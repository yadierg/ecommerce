# Crear el archivo en la raíz del proyecto
cat > .env.development << 'EOF'
# ============================================
# APLICACIÓN
# ============================================
NODE_ENV=development

# Puertos
STORE_PORT=3001
BUDGET_PORT=3003
INVENTORY_PORT=3002
ADMIN_PORT=3004

# ============================================
# BASE DE DATOS
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecommerce
DB_PASSWORD=dev123
DB_NAME=ecommerce_dev
DB_SCHEMA=public

# ============================================
# JWT
# ============================================
JWT_SECRET=dev_super_secret_key_12345_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ============================================
# CORS
# ============================================
CORS_ORIGIN=*
EOF