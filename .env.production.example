# ============================================
# ECOMMERCE - PRODUCCIÓN
# ============================================

NODE_ENV=production

# ============================================
# BASE DE DATOS
# ============================================
DB_USER=ecommerce
DB_PASSWORD=CAMBIAR_PASSWORD_FUERTE
DB_NAME=ecommerce_prod
DB_SCHEMA=public

# ============================================
# JWT (CAMBIAR EN PRODUCCIÓN)
# ============================================
# Generar con: openssl rand -base64 64
JWT_SECRET=CAMBIAR_SECRETO_64_BYTES
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# REDIS
# ============================================
# Generar con: openssl rand -base64 32
REDIS_PASSWORD=CAMBIAR_PASSWORD_REDIS

# ============================================
# RABBITMQ
# ============================================
RABBITMQ_USER=ecommerce
RABBITMQ_PASS=CAMBIAR_PASSWORD_RABBITMQ

# ============================================
# CORS
# ============================================
CORS_ORIGIN=https://instelec-electric.com,https://www.instelec-electric.com,https://api.instelec-electric.com