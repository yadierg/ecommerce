// tsconfig.base.json
{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "declaration": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ecommerce/auth": ["libs/auth/src/index.ts"],
      "@ecommerce/core": ["libs/core/src/index.ts"],
      "@ecommerce/database": ["libs/database/src/index.ts"],
      "@ecommerce/shared": ["libs/shared/src/index.ts"],
      "@ecommerce/events": ["libs/events/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}