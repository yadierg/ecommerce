{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@ecommerce/auth": ["./auth/src/index.ts"],
      "@ecommerce/core": ["./core/src/index.ts"],
      "@ecommerce/database": ["./database/src/index.ts"],
      "@ecommerce/shared": ["./shared/src/index.ts"],
      "@ecommerce/events": ["./events/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
